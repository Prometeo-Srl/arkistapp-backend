APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Mail. The app sends transactional mail the user is waiting on — the
# "modifica email" verification code today, a password reset next — so `log` is
# not a usable default for anyone testing a flow: the code ends up in
# storage/logs/laravel.log instead of a mailbox.
#
# Dev is Mailtrap's Email Testing sandbox: it accepts every message and files it
# in a web inbox instead of relaying it, so no sending domain and no DNS are
# needed and MAIL_FROM_ADDRESS can be anything. Credentials are per inbox —
# "SMTP Settings" -> Laravel — and are not the `api` token that Mailtrap's real
# sending product uses.
#
# What this does and does not prove: the message is byte-for-byte what a real
# recipient would receive — same headers, subject, body, From and To — so the
# code, its wording and the whole app-side flow are properly tested. What stays
# untested is everything after acceptance: SPF/DKIM/DMARC passing, inbox versus
# spam folder, bounces, rendering in real clients. That can only be tested once
# a real sending domain exists, and the sandbox's own spam-score report is the
# closest approximation until then.
#
# Real delivery, when a domain is available: Mailtrap Email Sending is
# MAIL_HOST=live.smtp.mailtrap.io, MAIL_PORT=587, MAIL_USERNAME=api and the API
# token from Settings -> API Tokens as the password, with MAIL_FROM_ADDRESS on a
# domain verified there (5 DNS records: 4 CNAME + 1 TXT for DMARC). Resend is
# the other option evaluated for production — resend/resend-php is already
# installed, so MAIL_MAILER=resend plus RESEND_KEY is all it needs. Either way a
# verified domain is mandatory: no provider will mail arbitrary recipients from
# an unverified one.
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=sandbox.smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="no-reply@arkistapp.it"
MAIL_FROM_NAME="${APP_NAME}"

# Unused while MAIL_MAILER=smtp. See the note above.
RESEND_KEY=

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=
